# Copy to .env only if you need different values
PORT=3002
# Local docker database (pnpm dev:db); the credentials are the docker-compose defaults, not secrets
DATABASE_URL=postgresql://pujcovna:pujcovna@localhost:5440/pujcovna_reference_data
# services/auth: its public signing keys, and the issuer and audience its tokens carry (must equal its BETTER_AUTH_URL)
AUTH_JWKS_URL=http://localhost:3100/auth/jwks
AUTH_ISSUER=http://localhost:3100
AUTH_AUDIENCE=http://localhost:3100

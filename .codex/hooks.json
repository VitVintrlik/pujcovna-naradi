{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/after-edit.mjs\"",
            "timeout": 30,
            "statusMessage": "Formatting and linting the file just written..."
          }
        ]
      }
    ]
  }
}

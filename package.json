{
  "name": "pujcovna-naradi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "docker compose up -d --wait && pnpm --parallel --filter \"./services/*\" --filter \"./apps/*\" dev",
    "dev:db": "docker compose up -d --wait",
    "dev:be": "docker compose up -d --wait && pnpm --parallel --filter \"./services/*\" dev",
    "dev:fe": "pnpm --filter \"./apps/web\" dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "check": "pnpm lint && pnpm typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}

# Copy to .env and fill in the secrets below
PORT=3100
# Local docker database (pnpm dev:db); the credentials are the docker-compose defaults, not secrets
DATABASE_URL=postgresql://pujcovna:pujcovna@localhost:5440/pujcovna_auth
BETTER_AUTH_URL=http://localhost:3100
WEB_ORIGIN=http://localhost:5173
# Generate with: openssl rand -base64 32 – changing it later requires pnpm --filter @pujcovna/auth-service db:reset
BETTER_AUTH_SECRET=
# Google Cloud Console › Credentials › OAuth client ID (Web application), redirect URI http://localhost:3100/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
